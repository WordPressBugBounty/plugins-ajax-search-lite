{
  "name": "wpdreams/admin-ui",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "WPDRMS\\AdminUI\\": "src/"
    }
  },
  "require": {
    "wpdreams/plugin-core": "*",
    "wpdreams/php-utils": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "2.*",
    "squizlabs/php_codesniffer": "*",
    "wp-coding-standards/wpcs": "*",
    "yoast/phpunit-polyfills": "*",
    "phpunit/phpunit": "9.*",
    "zircote/swagger-php": "*",
    "mockery/mockery": "^1.6",
    "php-mock/php-mock": "^2.5",
    "php-mock/php-mock-phpunit": "^2.10",
    "wp-cli/wp-cli-bundle": "*",
    "doctrine/instantiator": "^1.5"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:wpdreams/plugin-core.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:wpdreams/php-utils.git"
    }
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4"
    }
  }
}